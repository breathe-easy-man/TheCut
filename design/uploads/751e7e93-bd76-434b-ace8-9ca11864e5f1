<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Daily Tracker</title>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    color: #1a1a1a;
    background: #fafafa;
  }
  #app { max-width: 480px; margin: 0 auto; padding: 16px 16px 40px; }
  h1 { font-size: 20px; font-weight: 700; }
  .sub { font-size: 12px; color: #888; margin-top: 2px; }

  .tabs { display: flex; gap: 8px; margin: 12px 0; }
  .tabs button {
    flex: 1; padding: 10px; border-radius: 8px; border: 1px solid #ddd;
    background: #fff; font-size: 14px; font-weight: 600; color: #666; cursor: pointer;
  }
  .tabs button.active { background: #1a1a1a; color: #fff; border-color: #1a1a1a; }

  .page { display: none; }
  .page.active { display: block; }

  .date-row { display: flex; align-items: center; gap: 8px; }
  .navbtn {
    background: #fff; border: 1px solid #ddd; border-radius: 8px;
    padding: 10px 14px; font-size: 15px; font-weight: 600; cursor: pointer;
  }
  .navbtn:active { background: #e8e8e8; }
  #dateInput {
    flex: 1; padding: 10px; border: 1px solid #ddd; border-radius: 8px;
    font-size: 14px; text-align: center; background: #fff; font-family: inherit;
  }
  .today-btn {
    width: 100%; padding: 8px; background: #fff; border: 1px solid #ddd;
    border-radius: 8px; font-size: 13px; cursor: pointer; color: #555; margin-top: 8px;
  }
  .daylabel { text-align: center; font-size: 13px; color: #666; margin-top: 8px; font-weight: 600; }

  .day-toggle { display: flex; gap: 8px; margin-top: 10px; }
  .day-toggle button {
    flex: 1; padding: 10px; border-radius: 8px; border: 1px solid #ddd;
    background: #fff; font-size: 13px; font-weight: 600; color: #666; cursor: pointer;
  }
  .day-toggle button.active { background: #1a1a1a; color: #fff; border-color: #1a1a1a; }

  /* Whole row is a label, so tapping anywhere on it flips the checkbox */
  .done-row {
    display: flex; align-items: center; gap: 10px; margin-top: 10px;
    background: #fff; border: 1px solid #eee; border-radius: 10px; padding: 14px;
    cursor: pointer; user-select: none;
  }
  .done-row:active { background: #f5f5f5; }
  .done-row .txt { flex: 1; font-size: 13px; font-weight: 600; }
  .switch { position: relative; width: 46px; height: 26px; flex: none; pointer-events: none; }
  .switch input { position: absolute; opacity: 0; width: 100%; height: 100%; margin: 0; }
  .slider {
    position: absolute; inset: 0; background: #ccc;
    border-radius: 26px; transition: .2s;
  }
  .slider:before {
    content: ""; position: absolute; height: 20px; width: 20px; left: 3px; bottom: 3px;
    background: #fff; border-radius: 50%; transition: .2s;
  }
  .switch input:checked ~ .slider { background: #10b981; }
  .switch input:checked ~ .slider:before { transform: translateX(20px); }

  .card { background: #fff; border-radius: 12px; padding: 14px; margin: 14px 0; border: 1px solid #eee; }
  .card h3 { font-size: 14px; margin-bottom: 12px; }

  .bar-row { margin-bottom: 12px; }
  .bar-label { display: flex; justify-content: space-between; font-size: 13px; margin-bottom: 5px; }
  .bar-label .name { font-weight: 600; }
  .bar-label .nums { color: #666; }
  .bar-bg { background: #eee; border-radius: 6px; height: 8px; overflow: hidden; }
  .bar-fill { height: 100%; border-radius: 6px; }
  .bar-fill.cal { background: #3b82f6; }
  .bar-fill.protein { background: #10b981; }
  .bar-fill.goal { background: #f59e0b; }
  .bar-fill.over { background: #ef4444; }
  .remaining { font-size: 12px; color: #666; margin-top: 3px; }

  .steps-row { display: flex; align-items: center; gap: 8px; margin-top: 6px; }
  .steps-row label { font-size: 13px; color: #666; flex: 1; }
  .steps-row input {
    width: 110px; padding: 8px; border: 1px solid #ddd; border-radius: 8px;
    font-size: 13px; font-family: inherit;
  }
  .hint { font-size: 11px; color: #999; margin-top: 6px; line-height: 1.4; }

  .meal-item {
    background: #fff; border: 1px solid #eee; border-radius: 10px;
    padding: 10px 12px; margin-bottom: 8px; display: flex; justify-content: space-between; align-items: center;
  }
  .meal-item .info { flex: 1; padding-right: 8px; }
  .meal-item .mname { font-size: 14px; font-weight: 600; }
  .meal-item .mnums { font-size: 12px; color: #666; margin-top: 2px; }
  .del-btn {
    background: #f5f5f5; border: 1px solid #e5e5e5; color: #999;
    font-size: 13px; padding: 6px 10px; border-radius: 6px; cursor: pointer;
  }
  .empty { text-align: center; color: #999; font-size: 13px; padding: 20px 0; }

  .add-form input {
    width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 8px;
    font-size: 14px; margin-bottom: 8px; font-family: inherit;
  }
  .row2 { display: flex; gap: 8px; }
  .row2 input { flex: 1; }
  .add-btn {
    width: 100%; padding: 12px; background: #1a1a1a; color: #fff; border: none;
    border-radius: 8px; font-size: 14px; font-weight: 600; cursor: pointer;
  }

  .stat-grid { display: flex; gap: 8px; }
  .stat { flex: 1; background: #f8f8f8; border-radius: 10px; padding: 10px; text-align: center; }
  .stat .big { font-size: 18px; font-weight: 700; }
  .stat .lbl { font-size: 11px; color: #777; margin-top: 2px; }

  table { width: 100%; border-collapse: collapse; font-size: 12px; }
  th { text-align: left; color: #888; font-weight: 600; padding: 6px 4px; border-bottom: 1px solid #eee; }
  td { padding: 7px 4px; border-bottom: 1px solid #f5f5f5; }
  td.num { text-align: right; }
  .pos { color: #10b981; }
  .neg { color: #ef4444; }
  .pending { color: #b45309; font-size: 11px; }

  .warn { background: #fff7ed; border: 1px solid #fed7aa; color: #9a3412; font-size: 12px;
    padding: 8px 10px; border-radius: 8px; margin-bottom: 12px; line-height: 1.4; }
  .ok { background: #f0fdf4; border: 1px solid #bbf7d0; color: #166534; font-size: 12px;
    padding: 8px 10px; border-radius: 8px; margin-bottom: 12px; }

  .io-row { display: flex; gap: 8px; }
  .io-row button {
    flex: 1; padding: 10px; border: 1px solid #ddd; background: #fff;
    border-radius: 8px; font-size: 13px; font-weight: 600; cursor: pointer;
  }
  #importArea {
    width: 100%; height: 90px; margin-top: 8px; padding: 8px; font-size: 11px;
    border: 1px solid #ddd; border-radius: 8px; font-family: monospace; display: none;
  }
  .danger { color: #b91c1c; border-color: #fecaca !important; }
  .move-row { display: flex; gap: 8px; align-items: center; margin-top: 10px; }
  .move-row input { flex: 1; padding: 9px; border: 1px solid #ddd; border-radius: 8px; font-size: 13px; font-family: inherit; }
  .move-row button { padding: 9px 12px; border: 1px solid #ddd; background: #fff; border-radius: 8px; font-size: 13px; font-weight: 600; cursor: pointer; }
</style>
</head>
<body>
<div id="app">
  <h1>Daily Tracker</h1>
  <div class="sub" id="storageMode"></div>

  <div class="tabs">
    <button type="button" data-tab="day" class="active">Today</button>
    <button type="button" data-tab="progress">Progress</button>
  </div>

  <div id="warnBox"></div>

  <div class="page active" id="page-day">
    <div class="date-row">
      <button class="navbtn" id="prevDay" type="button">Prev</button>
      <input type="date" id="dateInput">
      <button class="navbtn" id="nextDay" type="button">Next</button>
    </div>
    <div class="daylabel" id="dayLabel"></div>
    <button class="today-btn" id="todayBtn" type="button">Jump to today</button>

    <div class="day-toggle">
      <button type="button" data-day="training">Training day</button>
      <button type="button" data-day="rest">Rest day</button>
    </div>

    <label class="done-row" for="doneToggle">
      <span class="txt">Day finished (count in progress)</span>
      <span class="switch">
        <input type="checkbox" id="doneToggle">
        <span class="slider"></span>
      </span>
    </label>
    <div class="hint" id="doneHint"></div>

    <div class="card">
      <div class="bar-row">
        <div class="bar-label"><span class="name">Calories</span><span class="nums" id="calNums"></span></div>
        <div class="bar-bg"><div class="bar-fill cal" id="calBar"></div></div>
        <div class="remaining" id="calRemaining"></div>
      </div>
      <div class="bar-row">
        <div class="bar-label"><span class="name">Protein</span><span class="nums" id="proNums"></span></div>
        <div class="bar-bg"><div class="bar-fill protein" id="proBar"></div></div>
        <div class="remaining" id="proRemaining"></div>
      </div>
      <div class="steps-row">
        <label for="stepsInput">Steps</label>
        <input type="number" id="stepsInput" placeholder="0" inputmode="numeric">
      </div>
      <div class="steps-row">
        <label for="weightInput">Weight (kg)</label>
        <input type="number" id="weightInput" placeholder="99.7" step="0.1" inputmode="decimal">
      </div>
      <div class="hint" id="stepHint"></div>
    </div>

    <div id="mealList"></div>

    <div class="card add-form">
      <h3>Add meal</h3>
      <input type="text" id="mealName" placeholder="e.g. Chicken breast + rice">
      <div class="row2">
        <input type="number" id="mealCal" placeholder="Calories" inputmode="numeric">
        <input type="number" id="mealProtein" placeholder="Protein (g)" inputmode="decimal">
      </div>
      <button class="add-btn" id="addBtn" type="button">Add meal</button>
    </div>

    <div class="card">
      <h3>Logged on the wrong day?</h3>
      <div class="move-row">
        <input type="date" id="moveTarget">
        <button type="button" id="moveBtn">Move</button>
      </div>
      <div class="hint" id="moveHint">Moves everything on the day you are viewing to the date you pick.</div>
    </div>
  </div>

  <div class="page" id="page-progress">
    <div class="card">
      <h3>Fat loss goal</h3>
      <div class="bar-row">
        <div class="bar-label"><span class="name">Estimated fat lost</span><span class="nums" id="goalNums"></span></div>
        <div class="bar-bg"><div class="bar-fill goal" id="goalBar"></div></div>
        <div class="remaining" id="goalEta"></div>
      </div>
      <div class="steps-row">
        <label for="goalInput">Goal (kg of fat)</label>
        <input type="number" id="goalInput" value="3" step="0.5" inputmode="decimal">
      </div>
      <div class="hint">Deficit is measured against maintenance (2950 cal plus step adjustment), not against the daily target. Only days marked finished count.</div>
    </div>

    <div class="card">
      <h3>Totals across finished days</h3>
      <div class="stat-grid">
        <div class="stat"><div class="big" id="statDays">0</div><div class="lbl">days counted</div></div>
        <div class="stat"><div class="big" id="statDeficit">0</div><div class="lbl">avg daily deficit</div></div>
        <div class="stat"><div class="big" id="statProtein">0g</div><div class="lbl">avg protein</div></div>
      </div>
      <div class="hint" id="pendingNote"></div>
    </div>

    <div class="card">
      <h3>Weight</h3>
      <div class="stat-grid">
        <div class="stat"><div class="big" id="statWStart">-</div><div class="lbl">first logged</div></div>
        <div class="stat"><div class="big" id="statWNow">-</div><div class="lbl">latest</div></div>
        <div class="stat"><div class="big" id="statWDelta">-</div><div class="lbl">change</div></div>
      </div>
      <div class="hint">Scale weight swings with water, food and glycogen. The two-week trend matters, not one day.</div>
    </div>

    <div class="card">
      <h3>Recent days</h3>
      <table>
        <thead><tr><th>Date</th><th class="num">Cal</th><th class="num">Target</th><th class="num">Diff</th><th class="num">Protein</th></tr></thead>
        <tbody id="histBody"></tbody>
      </table>
      <div class="hint">Days not marked finished show as in progress and stay out of the averages.</div>
    </div>

    <div class="card">
      <h3>Backup</h3>
      <div class="io-row">
        <button type="button" id="exportBtn">Copy my data</button>
        <button type="button" id="importBtn">Restore data</button>
      </div>
      <textarea id="importArea" placeholder="Paste backup text here, then press Restore data again"></textarea>
      <div class="hint" id="ioHint">Useful before clearing browser data or moving to another device.</div>
      <div class="io-row" style="margin-top:10px;">
        <button type="button" id="resetBtn" class="danger">Erase all data</button>
      </div>
    </div>
  </div>
</div>

<script>
(function() {
  var BASE = {
    training: { cal: 2750, protein: 190 },
    rest:     { cal: 2550, protein: 190 }
  };
  var BASE_STEPS = 2500;
  var CAL_PER_1000_STEPS = 45;
  var MAINTENANCE = 2950;
  var KCAL_PER_KG_FAT = 7700;
  var KEY = 'daily-tracker-data';

  var store = {
    ok: false,
    get: function(k) { try { return window.localStorage.getItem(k); } catch (e) { return null; } },
    set: function(k, v) { try { window.localStorage.setItem(k, v); return true; } catch (e) { return false; } },
    del: function(k) { try { window.localStorage.removeItem(k); } catch (e) {} }
  };
  try {
    window.localStorage.setItem('__t', '1');
    window.localStorage.removeItem('__t');
    store.ok = true;
  } catch (e) { store.ok = false; }

  function ymd(d) {
    return d.getFullYear() + '-' +
      String(d.getMonth() + 1).padStart(2, '0') + '-' +
      String(d.getDate()).padStart(2, '0');
  }
  function todayStr() { return ymd(new Date()); }
  function parseDate(s) {
    var p = s.split('-');
    return new Date(Number(p[0]), Number(p[1]) - 1, Number(p[2]));
  }
  function round1(n) { return Math.round(n * 10) / 10; }

  var cache = {};
  var settings = { goalKg: 3 };
  var currentDate = todayStr();
  var currentTab = 'day';
  var flash = '';

  function defaultDay() {
    return { dayType: 'rest', meals: [], steps: '', weight: '', done: false };
  }
  function getDay(date) {
    if (!cache[date]) cache[date] = defaultDay();
    if (typeof cache[date].done === 'undefined') cache[date].done = false;
    return cache[date];
  }
  function isEmptyDay(d) {
    return !d || ((!d.meals || d.meals.length === 0) && !d.steps && !d.weight);
  }

  function save() {
    if (!store.ok) return;
    store.set(KEY, JSON.stringify({ logs: cache, settings: settings }));
  }

  function load() {
    if (!store.ok) return;
    var raw = store.get(KEY);
    if (!raw) return;
    try {
      var data = JSON.parse(raw);
      if (data.logs) cache = data.logs;
      if (data.settings && data.settings.goalKg) settings.goalKg = data.settings.goalKg;
    } catch (e) {}
  }

  function backfillDoneFlags() {
    var t = todayStr();
    var changed = false;
    for (var k in cache) {
      var d = cache[k];
      if (typeof d.done === 'undefined') {
        d.done = (k < t) && d.meals && d.meals.length > 0;
        changed = true;
      }
    }
    if (changed) save();
  }

  function stepBonus(day) {
    var s = Number(day.steps) || 0;
    if (!s) return 0;
    return Math.round(((s - BASE_STEPS) / 1000) * CAL_PER_1000_STEPS);
  }
  function targetFor(day) {
    var base = BASE[day.dayType] || BASE.rest;
    return { cal: base.cal + stepBonus(day), protein: base.protein };
  }
  function totals(day) {
    var cal = 0, protein = 0;
    for (var i = 0; i < day.meals.length; i++) {
      cal += Number(day.meals[i].cal) || 0;
      protein += Number(day.meals[i].protein) || 0;
    }
    return { cal: cal, protein: round1(protein) };
  }
  function allLoggedDates() {
    var out = [];
    for (var k in cache) {
      if (cache[k] && cache[k].meals && cache[k].meals.length > 0) out.push(k);
    }
    out.sort();
    return out;
  }
  function countedDates() {
    return allLoggedDates().filter(function(d) { return getDay(d).done; });
  }

  function renderWarn() {
    var box = document.getElementById('warnBox');
    if (flash) box.innerHTML = '<div class="ok">' + flash + '</div>';
    else if (!store.ok) box.innerHTML = '<div class="warn">This browser is blocking storage, so entries will not survive a refresh. Use Copy my data on the Progress tab.</div>';
    else box.innerHTML = '';
  }

  function renderDay() {
    var day = getDay(currentDate);
    var t = totals(day);
    var target = targetFor(day);

    document.getElementById('dateInput').value = currentDate;
    var label = parseDate(currentDate).toLocaleDateString('en-GB',
      { weekday: 'long', day: 'numeric', month: 'long' });
    document.getElementById('dayLabel').textContent =
      label + (currentDate === todayStr() ? ' (today)' : '');

    var toggles = document.querySelectorAll('[data-day]');
    for (var i = 0; i < toggles.length; i++) {
      toggles[i].className = (toggles[i].getAttribute('data-day') === day.dayType) ? 'active' : '';
    }

    document.getElementById('doneToggle').checked = !!day.done;
    document.getElementById('doneHint').textContent = day.done
      ? 'Counted in your progress averages.'
      : 'Not counted yet. Switch this on once you have logged everything for the day.';

    document.getElementById('calNums').textContent = t.cal + ' / ' + target.cal;
    var calBar = document.getElementById('calBar');
    calBar.style.width = Math.min(100, (t.cal / target.cal) * 100) + '%';
    calBar.className = 'bar-fill ' + (t.cal > target.cal ? 'over' : 'cal');
    var calLeft = target.cal - t.cal;
    document.getElementById('calRemaining').textContent =
      calLeft >= 0 ? (calLeft + ' cal left') : (Math.abs(calLeft) + ' cal over');

    document.getElementById('proNums').textContent = t.protein + 'g / ' + target.protein + 'g';
    document.getElementById('proBar').style.width =
      Math.min(100, (t.protein / target.protein) * 100) + '%';
    var proLeft = round1(target.protein - t.protein);
    document.getElementById('proRemaining').textContent =
      proLeft > 0 ? (proLeft + 'g protein left') : 'protein target hit';

    document.getElementById('stepsInput').value = day.steps || '';
    document.getElementById('weightInput').value = day.weight || '';

    var bonus = stepBonus(day);
    var hint = document.getElementById('stepHint');
    if (!day.steps) {
      hint.textContent = 'Steps adjust this day\'s calorie target. Baseline ' + BASE_STEPS +
        '; every extra 1000 adds about ' + CAL_PER_1000_STEPS + ' cal.';
    } else if (bonus === 0) {
      hint.textContent = 'At the ' + BASE_STEPS + '-step baseline, no adjustment.';
    } else if (bonus > 0) {
      hint.textContent = 'Above baseline, target raised by ' + bonus + ' cal.';
    } else {
      hint.textContent = 'Below baseline, target lowered by ' + Math.abs(bonus) + ' cal.';
    }

    var list = document.getElementById('mealList');
    if (day.meals.length === 0) {
      list.innerHTML = '<div class="empty">No meals logged yet</div>';
    } else {
      var html = '';
      for (var j = 0; j < day.meals.length; j++) {
        var m = day.meals[j];
        var safe = String(m.name).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
        html += '<div class="meal-item"><div class="info">' +
                '<div class="mname">' + safe + '</div>' +
                '<div class="mnums">' + m.cal + ' cal, ' + round1(Number(m.protein)) + 'g protein</div>' +
                '</div><button type="button" class="del-btn" data-remove="' + m.id + '">Del</button></div>';
      }
      list.innerHTML = html;
    }
  }

  function renderProgress() {
    var counted = countedDates();
    var all = allLoggedDates();
    var totalDeficit = 0, totalProtein = 0;

    for (var i = 0; i < counted.length; i++) {
      var d = getDay(counted[i]);
      var t = totals(d);
      totalDeficit += (MAINTENANCE + stepBonus(d)) - t.cal;
      totalProtein += t.protein;
    }

    var n = counted.length;
    document.getElementById('statDays').textContent = n;
    document.getElementById('statDeficit').textContent = n ? Math.round(totalDeficit / n) : 0;
    document.getElementById('statProtein').textContent = (n ? Math.round(totalProtein / n) : 0) + 'g';

    var pendingCount = all.length - n;
    document.getElementById('pendingNote').textContent = pendingCount
      ? (pendingCount + ' logged day' + (pendingCount > 1 ? 's are' : ' is') + ' not marked finished and stays out of these numbers.')
      : '';

    var kgLost = totalDeficit / KCAL_PER_KG_FAT;
    var goal = Number(settings.goalKg) || 3;
    document.getElementById('goalNums').textContent = kgLost.toFixed(2) + ' / ' + goal + ' kg';
    document.getElementById('goalBar').style.width =
      Math.max(0, Math.min(100, (kgLost / goal) * 100)) + '%';

    var avgDef = n ? (totalDeficit / n) : 0;
    var etaEl = document.getElementById('goalEta');
    if (n < 3) etaEl.textContent = 'Mark a few finished days for a meaningful projection.';
    else if (avgDef <= 0) etaEl.textContent = 'At or above maintenance on average, so no fat loss projected.';
    else {
      var rem = goal - kgLost;
      etaEl.textContent = rem <= 0 ? 'Goal reached based on logged deficit.'
        : 'About ' + Math.ceil((rem * KCAL_PER_KG_FAT) / avgDef) + ' more days at ' + Math.round(avgDef) + ' cal/day.';
    }

    var wDates = [];
    for (var k in cache) { if (cache[k].weight) wDates.push(k); }
    wDates.sort();
    if (wDates.length) {
      var first = Number(getDay(wDates[0]).weight);
      var last = Number(getDay(wDates[wDates.length - 1]).weight);
      document.getElementById('statWStart').textContent = first.toFixed(1);
      document.getElementById('statWNow').textContent = last.toFixed(1);
      var delta = last - first;
      document.getElementById('statWDelta').textContent = (delta >= 0 ? '+' : '') + delta.toFixed(1);
    } else {
      document.getElementById('statWStart').textContent = '-';
      document.getElementById('statWNow').textContent = '-';
      document.getElementById('statWDelta').textContent = '-';
    }

    var rows = '';
    var recent = all.slice(-14).reverse();
    for (var r = 0; r < recent.length; r++) {
      var dd = getDay(recent[r]);
      var tt = totals(dd), tg = targetFor(dd);
      var diff = tt.cal - tg.cal;
      var lbl = parseDate(recent[r]).toLocaleDateString('en-GB', { day: 'numeric', month: 'short' });
      if (!dd.done) {
        rows += '<tr><td>' + lbl + ' <span class="pending">in progress</span></td>' +
                '<td class="num">' + tt.cal + '</td><td class="num">' + tg.cal +
                '</td><td class="num pending">-</td><td class="num">' + tt.protein + 'g</td></tr>';
      } else {
        rows += '<tr><td>' + lbl + '</td><td class="num">' + tt.cal + '</td><td class="num">' + tg.cal +
                '</td><td class="num ' + (diff > 0 ? 'neg' : 'pos') + '">' + (diff > 0 ? '+' : '') + diff +
                '</td><td class="num">' + tt.protein + 'g</td></tr>';
      }
    }
    document.getElementById('histBody').innerHTML =
      rows || '<tr><td colspan="5" class="empty">No days logged yet</td></tr>';

    document.getElementById('goalInput').value = settings.goalKg;
  }

  function render() {
    renderWarn();
    if (currentTab === 'day') renderDay(); else renderProgress();
  }

  function flashMsg(msg) {
    flash = msg; render();
    setTimeout(function() { flash = ''; renderWarn(); }, 3000);
  }

  function shift(days) {
    var d = parseDate(currentDate);
    d.setDate(d.getDate() + days);
    currentDate = ymd(d);
    render();
  }

  document.querySelector('.tabs').addEventListener('click', function(e) {
    var btn = e.target.closest('[data-tab]');
    if (!btn) return;
    currentTab = btn.getAttribute('data-tab');
    var tabBtns = document.querySelectorAll('[data-tab]');
    for (var i = 0; i < tabBtns.length; i++) tabBtns[i].className = (tabBtns[i] === btn) ? 'active' : '';
    document.getElementById('page-day').className = 'page' + (currentTab === 'day' ? ' active' : '');
    document.getElementById('page-progress').className = 'page' + (currentTab === 'progress' ? ' active' : '');
    render();
  });

  document.getElementById('prevDay').addEventListener('click', function() { shift(-1); });
  document.getElementById('nextDay').addEventListener('click', function() { shift(1); });
  document.getElementById('todayBtn').addEventListener('click', function() { currentDate = todayStr(); render(); });
  document.getElementById('dateInput').addEventListener('change', function(e) {
    if (e.target.value) { currentDate = e.target.value; render(); }
  });

  document.querySelector('.day-toggle').addEventListener('click', function(e) {
    var btn = e.target.closest('[data-day]');
    if (!btn) return;
    getDay(currentDate).dayType = btn.getAttribute('data-day');
    save(); render();
  });

  // Checkbox fires change when the wrapping label is tapped
  document.getElementById('doneToggle').addEventListener('change', function(e) {
    getDay(currentDate).done = e.target.checked;
    save(); render();
  });

  document.getElementById('mealList').addEventListener('click', function(e) {
    var btn = e.target.closest('[data-remove]');
    if (!btn) return;
    var id = Number(btn.getAttribute('data-remove'));
    var day = getDay(currentDate);
    day.meals = day.meals.filter(function(m) { return m.id !== id; });
    save(); render();
  });

  document.getElementById('stepsInput').addEventListener('change', function(e) {
    getDay(currentDate).steps = e.target.value; save(); render();
  });
  document.getElementById('weightInput').addEventListener('change', function(e) {
    getDay(currentDate).weight = e.target.value; save();
  });
  document.getElementById('goalInput').addEventListener('change', function(e) {
    settings.goalKg = Number(e.target.value) || 3; save(); render();
  });

  document.getElementById('addBtn').addEventListener('click', function() {
    var nameEl = document.getElementById('mealName');
    var calEl = document.getElementById('mealCal');
    var proEl = document.getElementById('mealProtein');
    var name = nameEl.value.trim();
    var cal = Number(calEl.value);
    var pro = Number(proEl.value);
    if (!name || !cal) return;
    getDay(currentDate).meals.push({ id: Date.now(), name: name, cal: cal, protein: pro || 0 });
    nameEl.value = ''; calEl.value = ''; proEl.value = '';
    save(); render();
  });

  document.getElementById('moveBtn').addEventListener('click', function() {
    var target = document.getElementById('moveTarget').value;
    var hint = document.getElementById('moveHint');
    if (!target) { hint.textContent = 'Pick a date to move this day to.'; return; }
    if (target === currentDate) { hint.textContent = 'That is the day you are already on.'; return; }
    var src = getDay(currentDate);
    if (isEmptyDay(src)) { hint.textContent = 'Nothing logged on this day to move.'; return; }
    if (!isEmptyDay(cache[target]) &&
        !window.confirm('That date already has entries. Overwrite them?')) return;
    cache[target] = src;
    delete cache[currentDate];
    currentDate = target;
    document.getElementById('moveTarget').value = '';
    hint.textContent = 'Moves everything on the day you are viewing to the date you pick.';
    save();
    flashMsg('Day moved.');
  });

  document.getElementById('exportBtn').addEventListener('click', function() {
    var area = document.getElementById('importArea');
    var hint = document.getElementById('ioHint');
    area.style.display = 'block';
    area.value = JSON.stringify({ logs: cache, settings: settings });
    area.select();
    try { document.execCommand('copy'); hint.textContent = 'Copied. Paste it somewhere safe.'; }
    catch (e) { hint.textContent = 'Select the text above and copy it manually.'; }
  });

  document.getElementById('importBtn').addEventListener('click', function() {
    var area = document.getElementById('importArea');
    var hint = document.getElementById('ioHint');
    if (area.style.display !== 'block' || !area.value.trim()) {
      area.style.display = 'block'; area.value = '';
      hint.textContent = 'Paste your backup above, then press Restore data again.';
      area.focus(); return;
    }
    try {
      var data = JSON.parse(area.value.trim());
      if (!data.logs) throw new Error('bad');
      cache = data.logs;
      if (data.settings && data.settings.goalKg) settings.goalKg = data.settings.goalKg;
      backfillDoneFlags();
      area.style.display = 'none'; area.value = '';
      hint.textContent = 'Data restored.';
      save(); render();
    } catch (e) { hint.textContent = 'Could not read that. Paste the whole backup text.'; }
  });

  document.getElementById('resetBtn').addEventListener('click', function() {
    if (!window.confirm('Erase all logged days? This cannot be undone.')) return;
    cache = {}; settings = { goalKg: 3 };
    store.del(KEY);
    currentDate = todayStr();
    render();
  });

  load();
  backfillDoneFlags();
  currentDate = todayStr();
  document.getElementById('storageMode').textContent =
    store.ok ? 'Saving automatically to this browser' : 'Storage unavailable, use backup';
  render();
})();
</script>
</body>
</html>
